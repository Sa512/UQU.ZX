# مفاتيح RevenueCat العامة (Public SDK keys) — تُفعّل الدفع الحقيقي عبر App Store وGoogle Play.
# بدونها يعمل التطبيق بالدفع التجريبي.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Supabase — يفعّل حجز الساعات المكتبية والتحضير بالـ QR الحقيقيين (بدونها: وضع تجريبي على الجهاز).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
